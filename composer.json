{
    "name": "nimblephp/twig",
    "description": "Twig for NimblePHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NimblePHP\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NimblePHP\\Twig\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Krzysztof Żyłka",
            "email": "krzysztofzylka@yahoo.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nimblephp/framework": ">=0.4.10",
        "twig/twig": "^3.23",
        "krzysztofzylka/file": "^1.0.7",
        "krzysztofzylka/generator": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
